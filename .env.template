# Database (docker-compose.yml las usa para crear el usuario y la base)
DB_USER=user_eventos
DB_PASSWORD=test1234
DB_NAME=db_eventos
DB_PORT=5402
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
# Si ves el aviso de SSL de pg: usa ?sslmode=verify-full (o en local sin SSL quita sslmode si lo tenías).
# Ejemplo con SSL: postgresql://user:pass@host:5432/db?sslmode=verify-full
DATABASE_URL=postgresql://user_eventos:test1234@localhost:5402/db_eventos

# Better Auth - clave secreta para encriptar sesiones (genera con: openssl rand -base64 32)
BETTER_AUTH_SECRET=tu-clave-secreta-de-al-menos-32-caracteres

# URL base de la app (para Better Auth). En producción debe ser la URL pública HTTPS.
BETTER_AUTH_URL=http://localhost:3000

# URL pública de la app (para el cliente y códigos QR). En producción debe coincidir con BETTER_AUTH_URL (ej. https://tu-dominio.com).
# Si no se define, el cliente usa window.location.origin en el navegador.
# NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# Cloudinary - imágenes de eventos (crea una cuenta en cloudinary.com)
# CLOUDINARY_CLOUD_NAME=tu-cloud-name
# CLOUDINARY_API_KEY=tu-api-key
# CLOUDINARY_API_SECRET=tu-api-secret

# --- Ticketing (boletos) ---
# Clave para firmar tokens de boleto y sesiones de puerta. Minimo 32 caracteres (genera con: openssl rand -base64 48).
# TICKET_SIGNING_SECRET=
# Resend - envio de correos (crea una cuenta en resend.com y verifica tu dominio).
# RESEND_API_KEY=
# Remitente de los correos, por ejemplo: Eventos <boletos@tu-dominio.com>
# EMAIL_FROM=
# NEXT_PUBLIC_APP_URL (arriba) pasa a ser obligatorio para los enlaces de boletos y QR en correos.
