# Database
DB_USER=db_eventos
DB_NAME=user_eventos
DB_PASSWORD=test1234
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgresql://user_eventos:test1234@localhost:5432/db_eventos

# Better Auth - clave secreta para encriptar sesiones (genera con: openssl rand -base64 32)
BETTER_AUTH_SECRET=tu-clave-secreta-de-al-menos-32-caracteres

# URL base de la app (para Better Auth)
BETTER_AUTH_URL=http://localhost:3000

# URL pública de la app (para códigos QR de eventos). En producción, usar tu dominio.
# NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# Cloudinary - imágenes de eventos (crea una cuenta en cloudinary.com)
# CLOUDINARY_CLOUD_NAME=tu-cloud-name
# CLOUDINARY_API_KEY=tu-api-key
# CLOUDINARY_API_SECRET=tu-api-secret

# Google Maps - autocompletado de ubicación al crear/editar eventos (console.cloud.google.com → APIs & Services → Places API)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-api-key
